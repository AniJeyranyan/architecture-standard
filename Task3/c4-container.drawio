        <mxCell id="c18" value="&lt;b style=&quot;font-size:15px&quot;&gt;Call center manager&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Bank call center&lt;/span&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1420" width="170" height="110" as="geometry"/></mxCell>
        <mxCell id="c19" value="&lt;b style=&quot;font-size:15px&quot;&gt;Website Frontend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Container: React.js]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Deposit list with rates; application form (name, phone, consent, CAPTCHA)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;CHANGED&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#E8710A;fontColor=#ffffff;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="80" y="360" width="420" height="120" as="geometry"/></mxCell>
        <mxCell id="c20" value="&lt;b style=&quot;font-size:15px&quot;&gt;Website Backend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Container: PHP]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Renders pages; gets public rates and sends applications to the API Gateway&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;CHANGED&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#E8710A;fontColor=#ffffff;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="80" y="580" width="420" height="130" as="geometry"/></mxCell>
        <mxCell id="c21" value="&lt;b style=&quot;font-size:15px&quot;&gt;Deposit Micro-frontend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Container: React, design system]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Deposits, personal rates, application form, OTP entry, status&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;NEW&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="620" y="360" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="c22" value="&lt;b style=&quot;font-size:15px&quot;&gt;IB Web UI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Container: ASP.NET MVC 4.5]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Existing IB pages; new &amp;quot;Deposits&amp;quot; menu item opens the micro-frontend&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;CHANGED&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#E8710A;fontColor=#ffffff;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="980" y="360" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="c23" value="&lt;b style=&quot;font-size:15px&quot;&gt;IB Database&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Container: MS SQL]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Users, sessions, payments&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;EXISTING&lt;/b&gt;&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1400" y="360" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="c24" value="&lt;b style=&quot;font-size:15px&quot;&gt;API Gateway + WAF&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Container: YARP on .NET 8]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Single entry: TLS, WAF, token check, rate limits, routing, correlation ID&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;NEW&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="620" y="560" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="c25" value="&lt;b style=&quot;font-size:15px&quot;&gt;IB Core (monolith)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Container: .NET 4.5, vendor platform]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Login, payments, accounts; new: issues OIDC tokens, reads reference data via API&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;CHANGED&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#E8710A;fontColor=#ffffff;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="980" y="560" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="c26" value="&lt;b style=&quot;font-size:15px&quot;&gt;Catalog &amp;amp; Rate Service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Container: .NET 8]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Products, terms, limits, public and personal rates, ref. data&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;NEW&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="600" y="820" width="220" height="130" as="geometry"/></mxCell>
        <mxCell id="c27" value="&lt;b style=&quot;font-size:15px&quot;&gt;Deposit Application Service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Container: .NET 8]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Website leads and IB applications, checks, status, outbox&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;NEW&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="880" y="820" width="220" height="130" as="geometry"/></mxCell>
        <mxCell id="c28" value="&lt;b style=&quot;font-size:15px&quot;&gt;OTP Service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Container: .NET 8]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Issues and checks one-time codes bound to the application&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;NEW&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1160" y="820" width="220" height="130" as="geometry"/></mxCell>
        <mxCell id="c29" value="&lt;b style=&quot;font-size:15px&quot;&gt;Notification Service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Container: .NET 8]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;SMS for OTP and status changes; templates, dedup&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;NEW&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1440" y="820" width="220" height="130" as="geometry"/></mxCell>
        <mxCell id="c30" value="&lt;b style=&quot;font-size:15px&quot;&gt;Catalog Cache&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Container: Redis]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Read model of products, rates, ref. data&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;NEW&lt;/b&gt;&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="600" y="1060" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="c31" value="&lt;b style=&quot;font-size:15px&quot;&gt;Deposit Services DB&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Container: MS SQL, Always On]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Applications, outbox, SMS log&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;NEW&lt;/b&gt;&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="880" y="1060" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="c32" value="&lt;b style=&quot;font-size:15px&quot;&gt;OTP Store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Container: Redis, TTL 5 min]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Hashed codes, attempt counters&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;NEW&lt;/b&gt;&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1160" y="1060" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="c33" value="&lt;b style=&quot;font-size:15px&quot;&gt;Kafka&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Container: Apache Kafka, cluster across 2 DCs]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Topics:
deposit.applications
deposit.application-status
deposit.rates (compacted)
client.rate-category (compacted)
reference-data (compacted)
+ DLQ topics&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;NEW&lt;/b&gt;&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1760" y="820" width="200" height="360" as="geometry"/></mxCell>
        <mxCell id="c34" value="&lt;b style=&quot;font-size:15px&quot;&gt;ABS Integration Adapter&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Container: .NET 8, ODP.NET]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Throttled consumer (≤ 5 appl./s, back-pressure); outbox relay&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;NEW&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2050" y="820" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="c35" value="&lt;b style=&quot;font-size:15px&quot;&gt;ABS Desktop Client&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Container: Delphi]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;New screens: rate management, application queue, approvals&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;CHANGED&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#E8710A;fontColor=#ffffff;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="2330" y="820" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c36" value="&lt;b style=&quot;font-size:15px&quot;&gt;ABS Integration API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Container: PL/SQL packages + outbox table]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Create/read applications; events in outbox&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;NEW&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2050" y="1030" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="c37" value="&lt;b style=&quot;font-size:15px&quot;&gt;ABS Database&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Container: Oracle, business logic in PL/SQL]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Deposit section: applications, deposits, rate grid and approvals (new). Credit section: client risk category view (new, only the category leaves the section). Accounts, postings, client documents.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;CHANGED&lt;/b&gt;&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#E8710A;fontColor=#ffffff;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="2050" y="1210" width="520" height="180" as="geometry"/></mxCell>
        <mxCell id="c38" value="&lt;b style=&quot;font-size:15px&quot;&gt;Call Center System&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Software System: vendor, Java, PostgreSQL]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;CRM card for website applications&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;CHANGED&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#E8710A;fontColor=#ffffff;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="240" y="1400" width="300" height="120" as="geometry"/></mxCell>
