        <mxCell id="c7" value="&lt;b style=&quot;font-size:15px&quot;&gt;IB client&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Existing client with IB access&lt;/span&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="170" height="110" as="geometry"/></mxCell>
        <mxCell id="c8" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1121" y="110" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b style=&quot;font-size:15px&quot;&gt;Branch employee&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Identifies clients, opens deposits&lt;/span&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1060" y="150" width="170" height="110" as="geometry"/></mxCell>
        <mxCell id="c10" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1351" y="110" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b style=&quot;font-size:15px&quot;&gt;Deposit back office&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Approves rates and applications&lt;/span&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1290" y="150" width="170" height="110" as="geometry"/></mxCell>
        <mxCell id="c12" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1581" y="110" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;b style=&quot;font-size:15px&quot;&gt;Credit back office&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Base rates, risk categories&lt;/span&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1520" y="150" width="170" height="110" as="geometry"/></mxCell>
        <mxCell id="c14" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="101" y="720" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c15" value="&lt;b style=&quot;font-size:15px&quot;&gt;Call center manager&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Calls website applicants&lt;/span&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="170" height="110" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;b style=&quot;font-size:15px&quot;&gt;Website&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Software System: PHP + React.js]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Deposit list with current rates; application form for new clients&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;CHANGED&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#E8710A;fontColor=#ffffff;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="50" y="400" width="290" height="170" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;b style=&quot;font-size:15px&quot;&gt;Internet Bank (IB)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Software System: .NET monolith + new .NET 8 deposit services, Kafka]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Personal rates, deposit applications with OTP confirmation, status, SMS notifications, rate and reference data cache&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;CHANGED&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#E8710A;fontColor=#ffffff;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="520" y="400" width="420" height="170" as="geometry"/></mxCell>
        <mxCell id="c18" value="&lt;b style=&quot;font-size:15px&quot;&gt;ABS (Core Banking System)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Software System: Oracle PL/SQL, Delphi]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Master of rates, applications, deposits and accounts; rate approval and application processing by the back office&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;CHANGED&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#E8710A;fontColor=#ffffff;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="1180" y="400" width="400" height="170" as="geometry"/></mxCell>
        <mxCell id="c19" value="&lt;b style=&quot;font-size:15px&quot;&gt;Call Center System&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Software System: vendor platform]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Cards for website applications; passes inquiries to the ABS&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;CHANGED&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#E8710A;fontColor=#ffffff;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="260" y="740" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="c20" value="&lt;b style=&quot;font-size:15px&quot;&gt;SMS Gateway&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Sends SMS through the telecom operator&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;EXISTING&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="720" y="740" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="c21" value="&lt;b style=&quot;font-size:15px&quot;&gt;Telecom Operator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[External System]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Delivers SMS to client phones&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;EXTERNAL&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#BFBFBF;strokeColor=#8C8C8C;fontColor=#222222;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1080" y="740" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="c22" value="&lt;b style=&quot;font-size:15px&quot;&gt;Bank of Russia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[External System]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Key rate, the basis for daily deposit rates&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;b&gt;EXTERNAL&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#BFBFBF;strokeColor=#8C8C8C;fontColor=#222222;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1520" y="740" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="c23" value="1. Views deposits, applies&lt;br&gt;UC1, UC2" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#222222;strokeWidth=1.5;rounded=0;" edge="1" parent="1" source="c5" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
