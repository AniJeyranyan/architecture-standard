        <mxCell id="c5" value="&lt;b style=&quot;font-size:15px&quot;&gt;Prospective client&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Website visitor, not yet a bank client&lt;/span&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="120" y="150" width="170" height="110" as="geometry"/></mxCell>
