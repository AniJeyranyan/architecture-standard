        <mxCell id="c2" value="Bank &quot;Standart&quot;: online deposit opening MVP. C4 Level 1: System context diagram" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1820" height="40" as="geometry"/></mxCell>
        <mxCell id="c3" value="Numbers on arrows match the context table in ADR.md. UC1–UC10 are the use cases from ADR.md. Partner call center and mobile app are out of MVP scope." style="text;html=1;fontSize=14;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1820" height="30" as="geometry"/></mxCell>
