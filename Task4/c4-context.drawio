<mxfile host="app.diagrams.net" agent="architecture-standart">
  <diagram id="page0" name="C4 Context">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c2" value="Bank &quot;Standart&quot;: deposit rates for the call centers. C4 Level 1: System context diagram" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1880" height="40" as="geometry"/></mxCell>
        <mxCell id="c3" value="Only the systems that take part in the new case are shown. Numbers on arrows match the context table in ADR.md, UC1–UC7 are the use cases from ADR.md. The website, the IB channels and online applications from Task3 do not change in this case and are left out." style="text;html=1;fontSize=14;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1880" height="40" as="geometry"/></mxCell>
        <mxCell id="c4" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="181" y="130" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b style=&quot;font-size:15px&quot;&gt;Client&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Often an elderly client; calls to ask about deposit conditions&lt;/span&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="110" y="170" width="190" height="110" as="geometry"/></mxCell>
        <mxCell id="c6" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="631" y="130" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b style=&quot;font-size:15px&quot;&gt;Bank call center operator&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Consults clients by phone&lt;/span&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="560" y="170" width="190" height="110" as="geometry"/></mxCell>
        <mxCell id="c8" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1691" y="130" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b style=&quot;font-size:15px&quot;&gt;Credit and deposit back office&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Maintain and approve the daily rates (Task3 UC9)&lt;/span&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1610" y="170" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="c10" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="181" y="780" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b style=&quot;font-size:15px&quot;&gt;Partner call center operator&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Takes overflow calls, consults on public rates&lt;/span&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="110" y="820" width="190" height="110" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;b style=&quot;font-size:15px&quot;&gt;Call Center System&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Software System: vendor platform, Java, PostgreSQL]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Operator workspace. New: screen with current deposit rates and conditions, refreshed from the bank's rate source&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:10px&quot;&gt;CHANGED&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#E8710A;fontColor=#ffffff;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="380" y="450" width="330" height="180" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;b style=&quot;font-size:15px&quot;&gt;Internet Bank: deposit services&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Software System: .NET 8 services, Kafka, Redis (Task3)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Catalog &amp;amp; Rate Service holds the published copy of approved rates. New: rate snapshot API for the call center and Rate File Export Service for the partner&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:10px&quot;&gt;CHANGED&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#E8710A;fontColor=#ffffff;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="940" y="450" width="380" height="180" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;b style=&quot;font-size:15px&quot;&gt;ABS (Core Banking System)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Software System: Oracle PL/SQL, Delphi]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Master of rates. Daily rate approval and publication to Kafka from Task3. Change: the deposit.rates event gets the rate set version, the number of items and the product conditions. No new functions&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:10px&quot;&gt;CHANGED (EVENT CONTRACT ONLY)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#E8710A;fontColor=#ffffff;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="1560" y="450" width="320" height="180" as="geometry"/></mxCell>
        <mxCell id="c15" value="&lt;b style=&quot;font-size:15px&quot;&gt;Partner Call Center System&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[External System: partner's own IS]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Outside the bank's network. Can receive files over SFTP; cannot call or offer APIs&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:10px&quot;&gt;EXTERNAL&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#BFBFBF;strokeColor=#8C8C8C;fontColor=#222222;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="420" y="800" width="360" height="170" as="geometry"/></mxCell>
        <mxCell id="e16" value="1. Calls the bank about deposit conditions [phone]" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#222222;strokeWidth=1.5;rounded=0;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e17" value="2. Overflow calls are routed to the partner [phone, telephony routing]" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#222222;strokeWidth=1.5;rounded=0;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e18" value="3. Looks up current rates during the call&lt;br&gt;UC2" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#222222;strokeWidth=1.5;rounded=0;" edge="1" parent="1" source="c7" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e19" value="4. Looks up current rates&lt;br&gt;UC6" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#222222;strokeWidth=1.5;rounded=0;" edge="1" parent="1" source="c11" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e20" value="5. Enters and approves daily rates&lt;br&gt;(Task3 UC9) UC1" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#8C8C8C;fontColor=#222222;strokeWidth=1.5;rounded=0;dashed=1;" edge="1" parent="1" source="c9" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e21" value="6. Approved rates&lt;br&gt;[Kafka deposit.rates, Task3;&lt;br&gt;event extended]&lt;br&gt;UC1" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#222222;strokeWidth=1.5;rounded=0;" edge="1" parent="1" source="c14" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e22" value="7. Gets the rate snapshot&lt;br&gt;[REST, mTLS + OAuth2,&lt;br&gt;every 5 min, ETag]&lt;br&gt;UC3" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#222222;strokeWidth=1.5;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e23" value="8. Rate files: CSV + checksum + signature&lt;br&gt;[SFTP push; on every approval + daily at 08:00]&lt;br&gt;UC4, UC5, UC7" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#222222;strokeWidth=1.5;rounded=0;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c24" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1590" y="770" width="330" height="225" as="geometry"/></mxCell>
        <mxCell id="c25" value="" style="rounded=1;html=1;fillColor=#08427B;strokeColor=#073B6F;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1602" y="805" width="66" height="25" as="geometry"/></mxCell>
        <mxCell id="c26" value="Person (user role)" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1680" y="805" width="235" height="25" as="geometry"/></mxCell>
        <mxCell id="c27" value="" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#E8710A;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="1602" y="842" width="66" height="25" as="geometry"/></mxCell>
        <mxCell id="c28" value="Changed system (orange border)" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1680" y="842" width="235" height="25" as="geometry"/></mxCell>
        <mxCell id="c31" value="" style="rounded=1;html=1;fillColor=#BFBFBF;strokeColor=#8C8C8C;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1602" y="879" width="66" height="25" as="geometry"/></mxCell>
        <mxCell id="c32" value="External system (partner)" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1680" y="879" width="235" height="25" as="geometry"/></mxCell>
        <mxCell id="c33" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1602" y="928" width="1" height="1" as="geometry"/></mxCell>
        <mxCell id="c34" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1668" y="928" width="1" height="1" as="geometry"/></mxCell>
        <mxCell id="e35" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c36" value="New integration" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1680" y="916" width="235" height="25" as="geometry"/></mxCell>
        <mxCell id="c37" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1602" y="965" width="1" height="1" as="geometry"/></mxCell>
        <mxCell id="c38" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1668" y="965" width="1" height="1" as="geometry"/></mxCell>
        <mxCell id="e39" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;strokeColor=#8C8C8C;dashed=1;" edge="1" parent="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c40" value="Integration from Task3 MVP, unchanged" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1680" y="953" width="235" height="25" as="geometry"/></mxCell>
