<mxfile host="app.diagrams.net" agent="architecture-standart">
  <diagram id="page0" name="C4 Component">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2660" pageHeight="1470" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c2" value="Bank &quot;Standart&quot;: deposit rates for the call centers. C4 Level 3: Component diagram" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="2580" height="40" as="geometry"/></mxCell>
        <mxCell id="c3" value="Components of the three containers that change: Call Center System, Catalog &amp;amp; Rate Service and the new Rate File Export Service. Arrows point from the component that starts the call; Kafka arrows show the event flow. Numbers match the component table in ADR.md. All new components send logs, metrics and traces to the observability stack from Task3 (not drawn)." style="text;html=1;fontSize=14;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="2580" height="40" as="geometry"/></mxCell>
        <mxCell id="c4" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="216" y="100" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b style=&quot;font-size:15px&quot;&gt;Bank call center operator&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Consults clients by phone&lt;/span&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="140" y="140" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="c6" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2416" y="100" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b style=&quot;font-size:15px&quot;&gt;Partner call center operator&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Consults clients by phone&lt;/span&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2340" y="140" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="c8" value="Call Center System [Container: vendor platform, Java, PostgreSQL] CHANGED (configuration)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#444444;strokeWidth=2;verticalAlign=bottom;align=left;spacingLeft=10;spacingBottom=4;fontStyle=1;fontSize=14;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="400" height="720" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b style=&quot;font-size:14px&quot;&gt;Operator Rates Screen&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[CRM screen / widget]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Products, rate grid by term and amount, conditions. Shows &quot;rates as of&quot;, warns if older than 24 h&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:10px&quot;&gt;NEW&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="135" y="380" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;b style=&quot;font-size:14px&quot;&gt;Rate Reference Table&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[PostgreSQL table]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Latest rate snapshot and its version; history of versions&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:10px&quot;&gt;NEW&lt;/b&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="135" y="600" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b style=&quot;font-size:14px&quot;&gt;Rate Sync Job&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[CRM scheduled integration job]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Every 5 min: GET with If-None-Match; saves only a new version; keeps the last one if the bank API is down&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:10px&quot;&gt;NEW&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="135" y="820" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;b style=&quot;font-size:14px&quot;&gt;API Gateway + WAF&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Container: YARP, .NET 8 (Task3)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;New route and OAuth2 client for the Call Center System, rate limit&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:10px&quot;&gt;EXISTING (NEW ROUTE)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="600" y="380" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;b style=&quot;font-size:14px&quot;&gt;Catalog Cache&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Container: Redis (Task3)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Read model of rates; now also the call center snapshot&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:10px&quot;&gt;EXISTING&lt;/b&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="600" y="800" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="c14" value="Catalog &amp;amp; Rate Service [Container: .NET 8] CHANGED" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#444444;strokeWidth=2;verticalAlign=bottom;align=left;spacingLeft=10;spacingBottom=4;fontStyle=1;fontSize=14;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="940" y="330" width="640" height="720" as="geometry"/></mxCell>
        <mxCell id="c15" value="&lt;b style=&quot;font-size:14px&quot;&gt;Call Center Rates API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[ASP.NET Core controller]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;GET /v1/call-center/rates: full public snapshot, ETag = version, 304 if unchanged&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:10px&quot;&gt;NEW&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="980" y="380" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;b style=&quot;font-size:14px&quot;&gt;Rate Snapshot Builder&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[.NET component]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Builds a versioned snapshot: public products, rate grid, conditions, valid_until. No personal rates&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:10px&quot;&gt;NEW&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="980" y="600" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;b style=&quot;font-size:14px&quot;&gt;Rates Kafka Consumer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[.NET, Confluent.Kafka (Task3)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Updates the read model; new: tells the builder when a rate set version is complete&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:10px&quot;&gt;CHANGED&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#E8710A;fontColor=#ffffff;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="980" y="820" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="c18" value="&lt;b style=&quot;font-size:14px&quot;&gt;Snapshot Publisher&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[.NET, Confluent.Kafka]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Publishes each new snapshot to the compacted topic deposit.rate-snapshot&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:10px&quot;&gt;NEW&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1290" y="820" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="c19" value="Rate File Export Service [Container: .NET 8 worker] NEW" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#444444;strokeWidth=2;verticalAlign=bottom;align=left;spacingLeft=10;spacingBottom=4;fontStyle=1;fontSize=14;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1660" y="330" width="600" height="720" as="geometry"/></mxCell>
        <mxCell id="c20" value="&lt;b style=&quot;font-size:14px&quot;&gt;File Builder and Signer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[.NET component]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;CSV (UTF-8, &quot;;&quot;), SHA-256 checksum file and detached signature&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:10px&quot;&gt;NEW&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1690" y="600" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="c21" value="&lt;b style=&quot;font-size:14px&quot;&gt;Snapshot Consumer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[.NET, Confluent.Kafka]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Consumes deposit.rate-snapshot; skips versions already delivered&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:10px&quot;&gt;NEW&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1690" y="820" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="c22" value="&lt;b style=&quot;font-size:14px&quot;&gt;Export Scheduler and Admin API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[.NET, Quartz.NET; REST (internal)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Daily file at 08:00; check &quot;delivered by 08:30&quot;; manual resend for support&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:10px&quot;&gt;NEW&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1980" y="380" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="c23" value="&lt;b style=&quot;font-size:14px&quot;&gt;SFTP Delivery Worker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[.NET, SSH.NET]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Uploads *.part, renames when complete; 5 retries with backoff, then alert&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:10px&quot;&gt;NEW&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1980" y="600" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="c24" value="&lt;b style=&quot;font-size:14px&quot;&gt;Export Log Repository&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[.NET, EF Core]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Delivery status per version; archive of every file sent&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:10px&quot;&gt;NEW&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1980" y="820" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="c25" value="&lt;b style=&quot;font-size:14px&quot;&gt;Secrets Vault / HSM&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Container (Task3 infrastructure)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Signing key, SSH private key&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:10px&quot;&gt;EXISTING&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1690" y="130" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="c26" value="&lt;b style=&quot;font-size:14px&quot;&gt;Kafka&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Container: Apache Kafka, 2 DCs (Task3)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;deposit.rates (Task3, schema extended) · deposit.rate-snapshot (new, compacted, key = &quot;public&quot;)&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:10px&quot;&gt;EXISTING&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="600" y="1110" width="1310" height="90" as="geometry"/></mxCell>
        <mxCell id="c27" value="&lt;b style=&quot;font-size:14px&quot;&gt;Deposit Services DB&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Container: MS SQL Always On (Task3)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;New schema rate_export&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:10px&quot;&gt;EXISTING&lt;/b&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1980" y="1100" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="c28" value="&lt;b style=&quot;font-size:14px&quot;&gt;ABS Integration Adapter&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Container: .NET 8 (Task3)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Publishes approved rates from the ABS outbox (Task3 UC9). Change: extended deposit.rates schema (rate set version, number of items, conditions)&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:10px&quot;&gt;CHANGED&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#E8710A;fontColor=#ffffff;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="600" y="1290" width="420" height="110" as="geometry"/></mxCell>
        <mxCell id="c29" value="&lt;b style=&quot;font-size:14px&quot;&gt;Partner SFTP Server&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[External: partner network]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Inbound folder for the bank; chroot, bank IP allow-list&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:10px&quot;&gt;EXTERNAL&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#BFBFBF;strokeColor=#8C8C8C;fontColor=#222222;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="2350" y="600" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="c30" value="&lt;b style=&quot;font-size:14px&quot;&gt;Partner Call Center System&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[External System]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Imports the latest file and shows rates to operators&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:10px&quot;&gt;EXTERNAL&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#BFBFBF;strokeColor=#8C8C8C;fontColor=#222222;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="2350" y="380" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="e31" value="1. Looks up rates during a call" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#222222;strokeWidth=1.5;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e32" value="2. Reads the latest snapshot" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#222222;strokeWidth=1.5;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e33" value="3. Saves a new version" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#222222;strokeWidth=1.5;rounded=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e34" value="4. GET /v1/call-center/rates&lt;br&gt;If-None-Match, every 5 min&lt;br&gt;[REST, mTLS + OAuth2 client credentials]" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#222222;strokeWidth=1.5;rounded=0;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e35" value="5. Routes" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#222222;strokeWidth=1.5;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e36" value="6. Reads the snapshot" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#222222;strokeWidth=1.5;rounded=0;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e37" value="7. deposit.rates (extended)" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#222222;strokeWidth=1.5;rounded=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.16;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c28" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e38" value="8. deposit.rates (extended)" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#222222;strokeWidth=1.5;rounded=0;exitX=0.34;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c26" target="c17"><mxGeometry x="-0.65" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e39" value="9. Updates the read model" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#8C8C8C;fontColor=#222222;strokeWidth=1.5;rounded=0;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
