        <mxCell id="v1" value="Bank &quot;Standart&quot;: Application Integration Diagram (AS-IS), deposit opening process" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="40" as="geometry"/></mxCell>
