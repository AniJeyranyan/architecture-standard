        <mxCell id="e31" value="works from scripts" style="html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#666666;fontColor=#666666;endArrow=open;strokeWidth=1.5;" edge="1" parent="1" source="v10" target="v11"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell>
        <mxCell id="e32" value="handed over manually" style="html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#666666;fontColor=#666666;endArrow=open;dashed=1;strokeWidth=1.5;" edge="1" parent="1" source="v12" target="v11"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell>
        <mxCell id="e33" value="A1. call: deposit terms" style="html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#1f5fa8;fontColor=#1f5fa8;endArrow=open;strokeWidth=1.5;" edge="1" parent="1" source="v4" target="v8"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell>
        <mxCell id="e34" value="A2. registers inquiry" style="html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#1f5fa8;fontColor=#1f5fa8;endArrow=open;strokeWidth=1.5;" edge="1" parent="1" source="v8" target="v9"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell>
        <mxCell id="e35" value="A3. inquiry → ABS" style="html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#1f5fa8;fontColor=#1f5fa8;endArrow=block;endFill=1;strokeWidth=2.5;" edge="1" parent="1" source="v9" target="v16"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell>
        <mxCell id="e36" value="A4. processes inquiry,&lt;br&gt;sets the rate" style="html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#1f5fa8;fontColor=#1f5fa8;endArrow=open;strokeWidth=1.5;exitX=0;exitY=0.25;entryX=1;entryY=0.5;" edge="1" parent="1" source="v23" target="v15"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell>
        <mxCell id="e37" value="A5. SMS: &quot;deposit available&lt;br&gt;at rate X, visit a branch&quot;" style="html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#1f5fa8;fontColor=#1f5fa8;endArrow=block;endFill=1;strokeWidth=2.5;" edge="1" parent="1" source="v14" target="v22"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell>
        <mxCell id="e38" value="A6. send SMS" style="html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#1f5fa8;fontColor=#1f5fa8;endArrow=block;endFill=1;strokeWidth=2.5;" edge="1" parent="1" source="v22" target="v5"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell>
        <mxCell id="e39" value="A7. SMS" style="html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#1f5fa8;fontColor=#1f5fa8;endArrow=block;endFill=1;strokeWidth=2.5;" edge="1" parent="1" source="v5" target="v4"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell>
        <mxCell id="e40" value="&lt;font color=&quot;#1f5fa8&quot;&gt;A8. comes with the SMS&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#d97706&quot;&gt;B1. walk-in, no call&lt;/font&gt;" style="html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;endArrow=open;strokeWidth=1.5;" edge="1" parent="1" source="v4" target="v13"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell>
        <mxCell id="e41" value="B2. e-mail: rate request" style="html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#d97706;fontColor=#d97706;endArrow=open;dashed=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.9;entryX=0.2;entryY=1;" edge="1" parent="1" source="v13" target="v23"><mxGeometry relative="1" x="-0.35" as="geometry"><Array as="points"><mxPoint x="395" y="1040"/><mxPoint x="1390" y="1040"/></Array></mxGeometry></mxCell>
        <mxCell id="e42" value="&lt;font color=&quot;#d97706&quot;&gt;B3. rate calculation&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7b3fa0&quot;&gt;C4. special rate&lt;/font&gt;" style="html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#d97706;fontColor=#d97706;endArrow=open;dashed=1;strokeWidth=1.5;exitX=1;exitY=0.1;entryX=0;entryY=0.7;" edge="1" parent="1" source="v23" target="v25"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell>
        <mxCell id="e43" value="B4. e-mail: reply with rate" style="html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#d97706;fontColor=#d97706;endArrow=open;dashed=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.8;exitY=1;entryX=1;entryY=0.65;" edge="1" parent="1" source="v23" target="v13"><mxGeometry relative="1" x="0.35" as="geometry"><Array as="points"><mxPoint x="1420" y="1065"/><mxPoint x="415" y="1065"/></Array></mxGeometry></mxCell>
        <mxCell id="e44" value="C1. e-mail: request&lt;br&gt;client risk data" style="html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#7b3fa0;fontColor=#7b3fa0;endArrow=open;dashed=1;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0;entryY=0.2;" edge="1" parent="1" source="v23" target="v24"><mxGeometry relative="1" x="-0.2" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e45" value="C2. client credit risk analysis" style="html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#7b3fa0;fontColor=#7b3fa0;endArrow=open;strokeWidth=1.5;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v24" target="v18"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell>
        <mxCell id="e46" value="C3. e-mail:&lt;br&gt;risk data" style="html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#7b3fa0;fontColor=#7b3fa0;endArrow=open;dashed=1;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=1;entryY=0.6;" edge="1" parent="1" source="v24" target="v23"><mxGeometry relative="1" x="-0.2" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e47" value="D1. CB rate (manual)" style="html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#b85450;fontColor=#b85450;endArrow=open;dashed=1;strokeWidth=1.5;" edge="1" parent="1" source="v26" target="v24"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell>
        <mxCell id="e48" value="D2. daily rate&lt;br&gt;calculation" style="html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#b85450;fontColor=#b85450;endArrow=open;dashed=1;strokeWidth=1.5;exitX=1;exitY=0;entryX=0.8;entryY=1;" edge="1" parent="1" source="v24" target="v25"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell>
        <mxCell id="e49" value="D3. daily Excel&lt;br&gt;file by e-mail" style="html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#b85450;fontColor=#b85450;endArrow=open;dashed=1;strokeWidth=1.5;exitX=0.3;exitY=1;entryX=1;entryY=0.35;" edge="1" parent="1" source="v25" target="v23"><mxGeometry relative="1" x="0.1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e50" value="F1. creates deposit,&lt;br&gt;uploads signed documents" style="html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#2e7d32;fontColor=#2e7d32;endArrow=open;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="v13" target="v15"><mxGeometry relative="1" x="-0.55" as="geometry"><Array as="points"><mxPoint x="820" y="832"/><mxPoint x="820" y="290"/></Array></mxGeometry></mxCell>
        <mxCell id="v51" value="Legend" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1130" width="100" height="24" as="geometry"/></mxCell>
        <mxCell id="v52" value="" style="point;" vertex="1" parent="1"><mxGeometry x="40" y="1175" width="1" height="1" as="geometry"/></mxCell>
        <mxCell id="v53" value="Automated system integration" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130" y="1160" width="220" height="30" as="geometry"/></mxCell>
        <mxCell id="e54" value="" style="html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#666666;fontColor=#666666;endArrow=block;endFill=1;strokeWidth=2.5;" edge="1" parent="1" source="v52" target="v53"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell>
        <mxCell id="v55" value="" style="point;" vertex="1" parent="1"><mxGeometry x="370" y="1175" width="1" height="1" as="geometry"/></mxCell>
        <mxCell id="v56" value="User action in a system / phone / visit" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="1160" width="220" height="30" as="geometry"/></mxCell>
        <mxCell id="e57" value="" style="html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#666666;fontColor=#666666;endArrow=open;strokeWidth=1.5;" edge="1" parent="1" source="v55" target="v56"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell>
        <mxCell id="v58" value="" style="point;" vertex="1" parent="1"><mxGeometry x="700" y="1175" width="1" height="1" as="geometry"/></mxCell>
        <mxCell id="v59" value="Manual exchange: e-mail / Excel" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="1160" width="220" height="30" as="geometry"/></mxCell>
        <mxCell id="e60" value="" style="html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#666666;fontColor=#666666;endArrow=open;dashed=1;strokeWidth=1.5;" edge="1" parent="1" source="v58" target="v59"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell>
        <mxCell id="v61" value="" style="point;" vertex="1" parent="1"><mxGeometry x="1030" y="1175" width="1" height="1" as="geometry"/></mxCell>
        <mxCell id="v62" value="Problematic integration (direct DB access)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="1160" width="220" height="30" as="geometry"/></mxCell>
        <mxCell id="e63" value="" style="html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#d32f2f;fontColor=#d32f2f;endArrow=block;endFill=1;strokeWidth=2.5;" edge="1" parent="1" source="v61" target="v62"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell>
        <mxCell id="v64" value="&lt;b&gt;&lt;font color=&quot;#1f5fa8&quot;&gt;A. Client called the call center first&lt;/font&gt;&lt;/b&gt;&lt;br&gt;A1. Client calls the call center&lt;br&gt;A2. Operator registers an inquiry&lt;br&gt;A3. Call center system passes it to the ABS&lt;br&gt;A4. Deposit manager sets the rate in the ABS&lt;br&gt;A5–A7. ABS sends an SMS via gateway and telecom&lt;br&gt;A8. Client comes to a branch → F1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#ffffff;strokeColor=#1f5fa8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1210" width="360" height="175" as="geometry"/></mxCell>
        <mxCell id="v65" value="&lt;b&gt;&lt;font color=&quot;#d97706&quot;&gt;B. Client comes to a branch without a call&lt;/font&gt;&lt;/b&gt;&lt;br&gt;B1. Client visits a branch&lt;br&gt;B2. Branch employee e-mails the back office&lt;br&gt;B3. Deposit manager calculates the rate in Excel&lt;br&gt;      (special rate → scenario C)&lt;br&gt;B4. Rate is sent back by e-mail and told to the client&lt;br&gt;→ F1 (client waits ~20 min)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="415" y="1210" width="360" height="175" as="geometry"/></mxCell>
        <mxCell id="v66" value="&lt;b&gt;&lt;font color=&quot;#7b3fa0&quot;&gt;C. Special rate (inside B, between B2 and B4)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;C1. Deposit manager e-mails the credit department&lt;br&gt;C2. Credit employee analyzes client risk in the ABS&lt;br&gt;C3. Risk data is sent back by e-mail&lt;br&gt;C4. Deposit manager calculates the special rate in Excel&lt;br&gt;→ B4 (client waits up to 1 hour)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#ffffff;strokeColor=#7b3fa0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="790" y="1210" width="360" height="175" as="geometry"/></mxCell>
        <mxCell id="v67" value="&lt;b&gt;&lt;font color=&quot;#b85450&quot;&gt;D. Daily rate preparation&lt;/font&gt;&lt;/b&gt;&lt;br&gt;D1. Credit dept. takes the Central Bank rate&lt;br&gt;D2. Calculates base rates in Excel&lt;br&gt;D3. Sends the Excel file to the deposit&lt;br&gt;      back office by e-mail every day" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1165" y="1210" width="340" height="175" as="geometry"/></mxCell>
        <mxCell id="v68" value="&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;F. Deposit opening (end of A and B)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;F1. Client confirms the rate; branch employee&lt;br&gt;creates the deposit in the ABS, prints documents,&lt;br&gt;client signs them, employee uploads the scans&lt;br&gt;to the ABS" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#ffffff;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1520" y="1210" width="360" height="175" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
