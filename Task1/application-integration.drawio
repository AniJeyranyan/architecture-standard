        <mxCell id="e28" value="HTTPS: payments, current accounts" style="html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#666666;fontColor=#666666;endArrow=open;strokeWidth=1.5;" edge="1" parent="1" source="v4" target="v7"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell>
        <mxCell id="e29" value="direct access to ABS database (SQL)" style="html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#d32f2f;fontColor=#d32f2f;endArrow=block;endFill=1;strokeWidth=2.5;" edge="1" parent="1" source="v7" target="v16"><mxGeometry relative="1"  as="geometry"></mxGeometry></mxCell>
